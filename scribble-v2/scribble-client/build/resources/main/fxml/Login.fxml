<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.scribble.client.ui.LoginController"
      alignment="CENTER" spacing="14" stylesheets="@/css/style.css">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24" />
    </padding>
    <Label text="Scribble" styleClass="title" />
    <Label text="Sign in to draw" styleClass="subtitle" />

    <TextField fx:id="usernameField" promptText="Username" />
    <TextField fx:id="hostField" promptText="Server Host" />
    <TextField fx:id="portField" promptText="Port" />

    <Button fx:id="connectButton" text="Connect" onAction="#onConnect" styleClass="primary-button" />
    <Label fx:id="statusLabel" text="" styleClass="status-text" />
</VBox>
