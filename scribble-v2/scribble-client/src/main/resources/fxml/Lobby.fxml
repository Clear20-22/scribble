<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.scribble.client.ui.LobbyController"
      spacing="14" alignment="CENTER" styleClass="screen">
    <padding>
        <Insets top="24" right="24" bottom="24" left="24" />
    </padding>

    <Label text="Lobby" styleClass="title" />
    <Label text="Choose a room" styleClass="subtitle" />
    <Label fx:id="connectionStatusLabel" text="Connected" styleClass="status-banner" />

    <TableView fx:id="roomTable" prefHeight="320">
        <columns>
            <TableColumn fx:id="nameColumn" text="Room" />
            <TableColumn fx:id="playersColumn" text="Players" />
            <TableColumn fx:id="statusColumn" text="Status" />
            <TableColumn fx:id="joinColumn" text="" />
        </columns>
    </TableView>

    <HBox spacing="10" alignment="CENTER">
        <Button fx:id="createButton" text="Create Room" onAction="#onCreateRoom" styleClass="primary-button" />
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh" />
    </HBox>

    <Label fx:id="statusLabel" text="" styleClass="status-text" />
</VBox>
