<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.scribble.client.ui.RoomController" styleClass="screen">
    <top>
        <VBox spacing="8">
            <padding>
                <Insets top="16" right="16" bottom="8" left="16" />
            </padding>
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="top-bar">
                <Label fx:id="roundLabel" text="Round: 0" styleClass="top-label" />
                <Label fx:id="timerLabel" text="Time: 60" styleClass="top-label" />
                <Label fx:id="wordLabel" text="Word: _ _ _" styleClass="top-label" />
                <Label fx:id="drawerLabel" text="Drawer: -" styleClass="top-label" />
                <Label fx:id="statusLabel" text="WAITING" styleClass="status-pill" />
                <ProgressIndicator fx:id="chooseSpinner" prefWidth="18" prefHeight="18" visible="false" managed="false" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="roleLabel" text="Player" styleClass="status-pill" />
                <Label fx:id="pingLabel" text="- ms" styleClass="status-pill" />
                <ToggleButton fx:id="networkMonitorToggle" text="📊 Network" styleClass="network-toggle" />
                <Button fx:id="leaveButton" text="Leave" styleClass="secondary-button" />
            </HBox>
            <Label fx:id="connectionStatusLabel" text="Connected" styleClass="status-banner" />
        </VBox>
    </top>

    <left>
        <VBox spacing="12" prefWidth="220">
            <padding>
                <Insets top="8" right="8" bottom="16" left="16" />
            </padding>
            <Label text="Players" styleClass="section-title" />
            <ListView fx:id="playerList" prefHeight="420" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="8" right="16" bottom="16" left="8" />
            </padding>
            <StackPane fx:id="canvasFrame" styleClass="canvas-frame" VBox.vgrow="ALWAYS">
                <Canvas fx:id="drawCanvas" width="740" height="520" styleClass="canvas-board" />
                <Label fx:id="choosingHintLabel" text="Drawer is choosing a word..." visible="false" managed="false"
                       styleClass="choosing-hint" />
                <VBox fx:id="wordChoiceOverlay" visible="false" managed="false" alignment="CENTER" spacing="12"
                      styleClass="choice-overlay">
                    <VBox spacing="6" alignment="CENTER" styleClass="choice-card">
                        <Label fx:id="wordChoiceTitle" text="Choose a word" styleClass="choice-title" />
                        <Label fx:id="wordChoiceTimer" text="Time left: 10s" styleClass="choice-subtitle" />
                        <HBox fx:id="wordChoiceButtons" spacing="10" alignment="CENTER" />
                    </VBox>
                </VBox>
                <VBox fx:id="leaderboardOverlay" visible="false" managed="false" alignment="CENTER" spacing="12"
                      styleClass="leaderboard-overlay">
                    <VBox spacing="10" alignment="CENTER" styleClass="leaderboard-card">
                        <Label fx:id="leaderboardTitle" text="Leaderboard" styleClass="leaderboard-title" />
                        <VBox fx:id="leaderboardRows" spacing="8" />
                        <Label fx:id="leaderboardVoteLabel" text="Waiting for votes..." styleClass="leaderboard-vote" />
                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="playAgainButton" text="Play Again" styleClass="primary-button" />
                            <Button fx:id="returnLobbyButton" text="Return to Lobby" styleClass="secondary-button" />
                            <Button fx:id="leaveRoomButton" text="Leave Room" styleClass="danger-button" />
                        </HBox>
                    </VBox>
                </VBox>
            </StackPane>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <HBox fx:id="paletteBox" spacing="6" />
                <Label text="Size" />
                <Slider fx:id="brushSlider" min="2" max="24" value="4" />
                <ToggleButton fx:id="eraserToggle" text="Eraser" />
                <Button fx:id="undoButton" text="Undo" />
                <Button fx:id="clearButton" text="Clear" styleClass="danger-button" />
            </HBox>
        </VBox>
    </center>

    <right>
        <VBox spacing="12" prefWidth="300">
            <padding>
                <Insets top="8" right="16" bottom="16" left="8" />
            </padding>
            <Label text="Chat" styleClass="section-title" />
            <ListView fx:id="chatList" prefHeight="460" />
            <TextField fx:id="chatInput" promptText="Type your guess or message and press Enter" />
        </VBox>
    </right>
    
    <bottom>
        <VBox fx:id="networkMonitorPanel" visible="false" managed="false" spacing="8" styleClass="network-panel">
            <padding>
                <Insets top="12" right="16" bottom="12" left="16" />
            </padding>
            <HBox spacing="20" alignment="CENTER_LEFT">
                <Label text="🌐 Network Monitor" styleClass="network-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Label fx:id="serverAddressLabel" text="Server: localhost:5555" styleClass="network-label" />
            </HBox>
            <HBox spacing="30" alignment="CENTER_LEFT">
                <!-- Connection Stats -->
                <VBox spacing="4" styleClass="stat-box">
                    <Label text="Connection" styleClass="stat-header" />
                    <HBox spacing="8">
                        <Label text="Duration:" styleClass="stat-label" />
                        <Label fx:id="connectionDurationLabel" text="0:00" styleClass="stat-value" />
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Reconnects:" styleClass="stat-label" />
                        <Label fx:id="reconnectCountLabel" text="0" styleClass="stat-value" />
                    </HBox>
                </VBox>
                
                <!-- Message Stats -->
                <VBox spacing="4" styleClass="stat-box">
                    <Label text="Messages" styleClass="stat-header" />
                    <HBox spacing="8">
                        <Label text="Sent:" styleClass="stat-label" />
                        <Label fx:id="messagesSentLabel" text="0" styleClass="stat-value" />
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Received:" styleClass="stat-label" />
                        <Label fx:id="messagesReceivedLabel" text="0" styleClass="stat-value" />
                    </HBox>
                </VBox>
                
                <!-- Bandwidth Stats -->
                <VBox spacing="4" styleClass="stat-box">
                    <Label text="Bandwidth" styleClass="stat-header" />
                    <HBox spacing="8">
                        <Label text="↑ Upload:" styleClass="stat-label" />
                        <Label fx:id="bytesSentLabel" text="0 B" styleClass="stat-value" />
                    </HBox>
                    <HBox spacing="8">
                        <Label text="↓ Download:" styleClass="stat-label" />
                        <Label fx:id="bytesReceivedLabel" text="0 B" styleClass="stat-value" />
                    </HBox>
                </VBox>
                
                <!-- Latency Stats -->
                <VBox spacing="4" styleClass="stat-box">
                    <Label text="Latency (RTT)" styleClass="stat-header" />
                    <HBox spacing="8">
                        <Label text="Current:" styleClass="stat-label" />
                        <Label fx:id="currentLatencyLabel" text="- ms" styleClass="stat-value-highlight" />
                    </HBox>
                    <HBox spacing="8">
                        <Label text="Avg/Min/Max:" styleClass="stat-label" />
                        <Label fx:id="latencyStatsLabel" text="-/-/- ms" styleClass="stat-value" />
                    </HBox>
                </VBox>
                
                <!-- Throughput -->
                <VBox spacing="4" styleClass="stat-box">
                    <Label text="Throughput" styleClass="stat-header" />
                    <HBox spacing="8">
                        <Label text="Msgs/sec:" styleClass="stat-label" />
                        <Label fx:id="throughputLabel" text="0.0" styleClass="stat-value" />
                    </HBox>
                </VBox>
            </HBox>
            
            <!-- Latency Graph Canvas -->
            <VBox spacing="4">
                <Label text="📈 Latency History (last 60 samples)" styleClass="stat-header" />
                <Canvas fx:id="latencyGraphCanvas" width="900" height="60" styleClass="latency-graph" />
            </VBox>
            
            <!-- Message Log -->
            <VBox spacing="4">
                <Label text="📋 Recent Packets (last 20)" styleClass="stat-header" />
                <ListView fx:id="messageLogList" prefHeight="80" styleClass="message-log" />
            </VBox>
        </VBox>
    </bottom>
</BorderPane>
